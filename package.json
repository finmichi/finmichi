{
  "name": "finmichi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm --filter @finmichi/db --filter @finmichi/core build && pnpm -r typecheck",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "migrate": "pnpm --filter @finmichi/db migrate",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "test:ui": "node scripts/transaction-ui-smoke.mjs",
    "test:query-ui": "node scripts/query-ui-smoke.mjs",
    "test:report-ui": "node scripts/report-ui-smoke.mjs",
    "test:life2023-ui": "node scripts/life2023-ui-smoke.mjs",
    "test:backup-ui": "node scripts/backup-ui-smoke.mjs",
    "test:mdb-export": "node scripts/mdb-export-smoke.mjs",
    "test:audit-ui": "node scripts/audit-ui-smoke.mjs",
    "test:pat-ui": "node scripts/pat-ui-smoke.mjs",
    "test:ux-foundations": "node scripts/ux-foundations-smoke.mjs",
    "test:ux-daily": "node scripts/ux-daily-smoke.mjs",
    "test:ux-entry": "node scripts/ux-entry-smoke.mjs",
    "test:ux-reports": "node scripts/ux-reports-smoke.mjs && node scripts/project-report-ui-smoke.mjs",
    "test:ux-recurring": "node scripts/ux-recurring-smoke.mjs",
    "test:ux-admin": "node scripts/ux-admin-smoke.mjs",
    "test:ux-budget": "node scripts/ux-budget-smoke.mjs",
    "test:ux-report-extensions": "node scripts/ux-report-extensions-smoke.mjs",
    "test:ux-finance": "node scripts/ux-finance-smoke.mjs",
    "test:ux-cash-forecast": "node scripts/ux-cash-forecast-smoke.mjs",
    "test:ux-mcp-drafts": "node scripts/ux-mcp-drafts-smoke.mjs",
    "test:ux-market": "node scripts/ux-market-smoke.mjs",
    "test:ux-stocks": "node scripts/ux-stocks-smoke.mjs",
    "test:ux-dividends": "node scripts/ux-dividends-smoke.mjs",
    "test:ux-scroll-chaining": "node scripts/ux-scroll-chaining-smoke.mjs",
    "test:ux-entry-scroll": "node scripts/ux-entry-scroll-smoke.mjs",
    "test:ux-deposits": "node scripts/ux-deposits-smoke.mjs",
    "test:ux-reminders": "node scripts/ux-reminders-smoke.mjs",
    "test:ux-investment-import": "node scripts/ux-investment-import-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.0",
    "csv-parse": "7.0.3",
    "eslint": "^9.37.0",
    "playwright": "1.62.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "license": "AGPL-3.0-only"
}
