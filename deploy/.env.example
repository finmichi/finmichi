# Copy only using setup-dev.sh: these are placeholders, not usable credentials.
PUBLIC_URL=https://localhost:8443
OIDC_ISSUER=http://localhost:8081/default
OIDC_CLIENT_ID=<DEV_CLIENT_ID>
ALLOWED_SUBJECTS=<SYNTHETIC_SUBJECT>
TRUST_PROXY=0
DATABASE_URL_FILE=/run/secrets/database-url
TLS_KEY_FILE=/run/secrets/tls-key
TLS_CERT_FILE=/run/secrets/tls-cert
APP_VERSION=0.0.1

# 單筆草稿本位幣上限（0.01–10000000，最多2位小數）
MCP_DRAFT_MAX_BASE_AMOUNT=100000

# Opt in after checking official source access. CI and synthetic tests keep this off.
MARKET_DATA_ENABLED=false
