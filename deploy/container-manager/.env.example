# FinMichi — Container Manager 版 .env（以 UTF-8 無 BOM 存檔）
# 三個匯入 image 的共同版本標籤（從 Release 頁確認）。
IMAGE_TAG=<RELEASE_TAG>
# NAS 的區域網路 IP，供 app 解析 sso.example.com。
NAS_LAN_IP=<NAS_LAN_IP>
# 必填：OIDC_ISSUER 的主機名稱，不含協定、port 或路徑，例如 sso.example.com。
OIDC_HAIRPIN_HOST=<OIDC_ISSUER_HOST>
# 網站完整 HTTPS 網址，不含結尾斜線。
PUBLIC_URL=<PUBLIC_HTTPS_URL>
# SSO issuer 完整 HTTPS 網址。
OIDC_ISSUER=<OIDC_ISSUER_URL>
OIDC_CLIENT_ID=<OIDC_CLIENT_ID>
# 包含 $、# 等字元時請用單引號包住完整值；勿把密碼貼到截圖或對話。
OIDC_CLIENT_SECRET='<OIDC_CLIENT_SECRET>'
# 重要：只能使用英文字母與數字（不得含 $ 或任何符號），32 字元以上。
# 建立 volume 後不要直接修改；這不會變更 DB 內原有密碼。
POSTGRES_PASSWORD=<ALPHANUMERIC_PASSWORD_AT_LEAST_32_CHARACTERS>
# 首次可填 placeholder-not-a-user；取得自己的 sub 後再填入，逗號分隔多個 sub。
ALLOWED_SUBJECTS=<ALLOWED_SUBJECTS>
# 首次確認 sub 設 true，確認白名單後必須改 false。
OIDC_SUBJECT_DISCOVERY=<TRUE_OR_FALSE>
# 是否啟用市場行情抓取；初次驗證建議 false。
MARKET_DATA_ENABLED=<TRUE_OR_FALSE>
# MCP 草稿本位幣上限；預設 100000，最高 10000000。
MCP_DRAFT_MAX_BASE_AMOUNT=<DRAFT_LIMIT>

# Destructive reset stays disabled unless explicitly enabled by the operator.
FINMICHI_ALLOW_FACTORY_RESET=false
