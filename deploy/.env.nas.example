# FinMichi — SSH 版 .env（以 UTF-8 無 BOM 存檔）
IMAGE_TAG=<APPROVED_RELEASE_TAG>
NAS_ROOT=<ABSOLUTE_NAS_PROJECT_DIRECTORY>
NAS_LAN_IP=<NAS_LAN_IP>
# 必填：OIDC_ISSUER 的主機名稱，不含協定、port 或路徑，例如 sso.example.com。
OIDC_HAIRPIN_HOST=<OIDC_ISSUER_HOST>
PUBLIC_URL=<HTTPS_PUBLIC_URL>
OIDC_ISSUER=<VERIFIED_HTTPS_OIDC_ISSUER>
OIDC_CLIENT_ID=<OIDC_CLIENT_ID>
ALLOWED_SUBJECTS=<VERIFIED_SUBJECT>
OIDC_SUBJECT_DISCOVERY=false
MARKET_DATA_ENABLED=false
MCP_DRAFT_MAX_BASE_AMOUNT=100000

# SSH 版密碼仍放 secrets 檔；不要在本檔重複填密碼。
# postgres-password：只能使用英文字母與數字（不得含 $ 或任何符號），32 字元以上；首次啟動後不得直接修改。
# 若改用 GUI 版，使用其範本 OIDC_CLIENT_SECRET='<OIDC_CLIENT_SECRET>'；SSH 版仍使用 oidc-client-secret 檔。

# Destructive reset stays disabled unless explicitly enabled by the operator.
FINMICHI_ALLOW_FACTORY_RESET=false
